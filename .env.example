# ─────────────────────────────────────────────────────────────────────────────
# CLAVIS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o projeto.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=production

# URL pública onde o projeto ficará hospedado (sem barra no final)
# Ex: https://meudominio.com ou http://SEU_IP_SERVIDOR
PUBLIC_URL=http://localhost

# ── Telegram ─────────────────────────────────────────────────────────────────
# Token do bot criado via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Username do bot (sem @)
TELEGRAM_BOT_USERNAME=clavisapp_bot

# URL do webhook (será PUBLIC_URL + /webhook/telegram)
# Preencha automaticamente: PUBLIC_URL/webhook/telegram
TELEGRAM_WEBHOOK_URL=${PUBLIC_URL}/webhook/telegram

# ── IA — OpenRouter ───────────────────────────────────────────────────────────
# Chave de API do OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://clavis.immo
OPENROUTER_APP_NAME=CLAVIS
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_segura_de_pelo_menos_32_caracteres
JWT_EXPIRES_IN=7d

# ── Banco de dados (não alterar se usar Docker Compose) ───────────────────────
MONGODB_URI=mongodb://mongo:27017/linkgri
REDIS_URL=redis://redis:6379

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL da API que o frontend vai chamar (dentro do Docker = pelo nginx)
VITE_API_URL=${PUBLIC_URL}
