# ============================================
# LinkGRI Backend - Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/linkgri
# For production with MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/linkgri?retryWrites=true&w=majority

# Cache - Redis
REDIS_URL=redis://localhost:6379
# For production:
# REDIS_URL=redis://username:password@host:port

# OpenRouter (unified API for multiple AI providers)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://linkgri.com
OPENROUTER_APP_NAME=LinkGRI

# Default models (OpenRouter format: provider/model)
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
# For local development with ngrok:
# TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok.io/webhook/telegram

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly

# Feature Flags
ENABLE_SSE=true
ENABLE_VECTOR_SEARCH=true

# Optional: Sentry for error tracking
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
